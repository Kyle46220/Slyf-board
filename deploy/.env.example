MATRIX_URL=http://synapse:8008
MATRIX_USER=@board:board.local
MATRIX_TOKEN=REPLACE_WITH_PRIVATE_MATRIX_USER_TOKEN
BRIDGE_BOT=@signalbot:board.local
BOARD_URL=https://board.slyfe.fyi
INGEST_TOKEN=REPLACE_WITH_SAME_64_HEX_TOKEN_AS_WORKER
# Group chats publish only native @mentions of the linked bot. Set disabled for DMs only.
GROUP_POSTING=mentions
# Private bot number in E.164 and local formats, comma-separated. Required for groups.
PROTECTED_PHONE_NUMBERS=REPLACE_WITH_PRIVATE_BOT_NUMBER
# Optional local ghost ID(s) of the linked bot, comma-separated. Never put these in frontend code.
BOT_MENTION_IDS=
# Optional restriction: only these comma-separated Matrix portal IDs may publish (DMs or groups).
ALLOWED_ROOMS=
# Pin these to tested immutable image digests before production deployment.
SYNAPSE_IMAGE=matrixdotorg/synapse:latest
SIGNAL_IMAGE=dock.mau.dev/mautrix/signal:latest
